# Copy to .env.local and fill in. .env.local is not committed.

# The address the site is published at, without a trailing slash (e.g. https://discover-tunisia.com).
# Used for the place pages' share previews, canonical links and the sitemap; leave empty for a local build.
# On Vercel it defaults to the project's production domain.
VITE_SITE_URL=

# Google Search Console: the code of the HTML-tag verification (content="…" of the meta tag it gives you).
GSC_VERIFICATION=

# Affiliate ids: empty means the hotel and tour links are plain searches (no commission).
VITE_BOOKING_AID=
VITE_GYG_PARTNER_ID=

# Live weather from the Open-Meteo forecast API (free for non-commercial use only; a commercial site needs
# their paid plan). Set to "off" to show the monthly averages only.
VITE_LIVE_WEATHER=on

# Google Maps Platform key with the "Map Tiles API" enabled (used for the satellite ground layer of El Jem).
# In Google Cloud, restrict it to the Map Tiles API and to your domains (http://localhost:5173/*, https://your-site/*).
VITE_GOOGLE_MAPS_KEY=
